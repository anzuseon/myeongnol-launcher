<section class="mn-home" aria-label="명선놀이터 홈">
    <div class="mn-profile" aria-label="선택한 계정">
        <button id="user_text" title="계정 관리">로그인해 주세요</button>
        <div id="avatarContainer">
            <img id="mn-avatar-image" src="assets/images/SealCircle.png" alt="캐릭터">
            <button id="avatarOverlay" title="계정 관리" aria-label="계정 관리"></button>
        </div>
    </div>
    <section class="mn-status-summary" aria-label="서버 상태">
        <div class="mn-status-line"><span>서버</span><strong id="mn-server-state" data-state="pending"><i></i>확인 중</strong><button id="mn-refresh-status" aria-label="서버 상태 새로고침">새로고침</button></div>
        <div id="server_status_wrapper">
            <span id="landingPlayerLabel">접속자</span><b id="player_count">— / —</b>
            <span>응답</span><b id="mn-server-latency">—</b>
            <button id="mn-game-version-button">Minecraft <b id="mn-quick-version">—</b></button>
            <span id="mn-server-version" hidden>—</span>
        </div>
    </section>
    <section class="mn-launch-area" aria-label="게임 실행">
        <div id="launch_content"><button id="launch_button">게임 실행</button></div>
        <div id="launch_details" style="display:none" aria-live="polite">
            <div class="mn-launch-state"><strong id="launch_progress_label">0%</strong><span id="launch_details_text">실행 준비 중...</span></div>
            <progress id="launch_progress" value="0" max="100"></progress>
        </div>
        <button id="server_selection_button" title="접속 서버 선택"><span id="mn-selected-server-name">서버 확인 중...</span></button>
    </section>
    <div class="mn-legacy-services" aria-hidden="true">
        <span id="mojang_status_icon"></span>
        <div id="mojangStatusEssentialContainer"></div><div id="mojangStatusNonEssentialContainer"></div>
    </div>
</section>

